{
    "name": "phpsoftbox/notifications",
    "description": "Notification component for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "phpsoftbox/cli-app": "^1.0",
        "phpsoftbox/code-generator": "^1.0",
        "phpsoftbox/collection": "^1.0",
        "phpsoftbox/view": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "erusev/parsedown": "^1.7",
        "phpsoftbox/broadcaster": "^1.0",
        "phpsoftbox/cs-fixer": "^1.2.2",
        "phpsoftbox/database": "^1.0",
        "phpsoftbox/mailer": "^1.0",
        "phpsoftbox/telegram": "^1.0",
        "phpunit/phpunit": "^13.3"
    },
    "suggest": {
        "erusev/parsedown": "Markdown to HTML in MarkdownToHtmlConverter (otherwise a minimal built-in converter is used).",
        "phpsoftbox/broadcaster": "Pushr channel (PushrPublisherAdapter).",
        "phpsoftbox/database": "Database channel, DatabaseNotificationRepository and notifications:prune.",
        "phpsoftbox/mailer": "Email channel (EmailChannel, EmailMessage).",
        "phpsoftbox/telegram": "Telegram channel."
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Notifications\\Tests\\": "tests/"
        }
    },
    "extra": {
        "psb": {
            "providers": [
                "PhpSoftBox\\Notifications\\Cli\\NotificationCommandProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "prefer-stable": true
}
